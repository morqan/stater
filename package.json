{
  "name": "stater",
  "version": "2.0.0",
  "private": true,
  "description": "Quick-start template for a new frontend project — Vite + React + TypeScript",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "author": "Qurbanov Murad",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morqan/stater.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "husky": "^9",
    "lint-staged": "^15",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  },
  "browserslist": [
    "defaults",
    "not dead"
  ]
}
